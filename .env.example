# ==========================================
# MCE — AI Company Operating System
# Environment Configuration Template
# ==========================================

# Environment Mode: development | staging | production
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:5173

# Backend API (CodeIgniter 4 - Fase 2)
API_BASE_URL=http://localhost:8080/api
CI_ENVIRONMENT=development

# MySQL Database Configuration (Fase 2)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mce_db
DB_USER=root
DB_PASS=

# AI Agent Runtime (Hermes - Fase 5)
HERMES_HOST=http://127.0.0.1:8000
HERMES_API_KEY=your_hermes_key_here

# AI Model Gateway (9Router - Fase 6)
ROUTER9_GATEWAY_URL=http://127.0.0.1:9000/v1
ROUTER9_API_KEY=your_9router_key_here

# Realtime SSE Configuration (Fase 8)
SSE_HEARTBEAT_SEC=15
