#--------------------------------------------------------------------
# MCE — CodeIgniter 4 Environment Configuration Template
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false
app.appTimezone = 'Asia/Jakarta'
app.defaultLocale = 'id'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = mce_db
database.default.username = root
database.default.password = 
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION
# Generate a new key using: php spark key:generate
#--------------------------------------------------------------------
# encryption.key = 

#--------------------------------------------------------------------
# CORS & POLICY ENGINE (MCE Custom)
#--------------------------------------------------------------------
mce.frontendURL = 'http://localhost:5173'
mce.directorAgentKey = 'director'
#--------------------------------------------------------------------
# HERMES AI AGENT RUNTIME CONFIG (Prompt 22)
#--------------------------------------------------------------------
# Runtime node endpoint. CI4 business control plane pushes scoped
# execution contexts to this Hermes daemon over HTTP/REST.
hermes.baseURL = 'http://127.0.0.1:8686/v1'
hermes.apiVersion = 'v1'
# Set true when no live Hermes daemon is reachable (controlled simulation fallback).
hermes.simulationMode = true
# Deterministic idempotency nonce scope for local development.
hermes.idempotencyNonce = 'mce-operator'
